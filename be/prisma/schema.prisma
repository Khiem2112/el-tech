/// SQL migration must add CHECK constraints for non-negative balances and
/// on_hand - reserved - quarantine_damaged >= 0.
model StockQuant {
  id                  String  @id @default(uuid()) @db.Uuid
  branchId            Int     @map("branch_id")
  skuId               Int     @map("sku_id")
  onHand              Int     @default(0) @map("on_hand")
  reserved            Int     @default(0)
  quarantineDamaged   Int     @default(0) @map("quarantine_damaged")
  weightedAverageCost Decimal @default(0) @map("weighted_average_cost") @db.Decimal(12, 2)
  version             Int     @default(0)

  branch        Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sku           ProductVariant     @relation(fields: [skuId], references: [id], onDelete: Restrict)
  ledgerEntries StockLedgerEntry[]

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([branchId, skuId])
  @@index([skuId])
  @@index([branchId, isActive])
  @@map("stock_quant")
}

/// A stock document header, equivalent to a deliberately small Odoo stock.picking.
/// ORDER_ISSUE in RESERVED state is the order reservation; validating that same
/// move consumes the reservation and issues stock.
model StockMove {
  id                  String          @id @default(uuid()) @db.Uuid
  code                String          @unique
  sourceBranchId      Int?            @map("source_branch_id")
  destinationBranchId Int?            @map("destination_branch_id")
  orderId             String?         @map("order_id") @db.Uuid
  purchaseOrderId     String?         @unique @map("purchase_order_id") @db.Uuid
  reversalOfMoveId    String?         @map("reversal_of_move_id") @db.Uuid
  idempotencyKey      String          @unique @map("idempotency_key")
  moveType            StockMoveType   @map("move_type")
  status              StockMoveStatus @default(DRAFT)
  reason              String?
  expiresAt           DateTime?       @map("expires_at") @db.Timestamptz(3)
  reservedAt          DateTime?       @map("reserved_at") @db.Timestamptz(3)
  dispatchedAt        DateTime?       @map("dispatched_at") @db.Timestamptz(3)
  validatedAt         DateTime?       @map("validated_at") @db.Timestamptz(3)
  cancelledAt         DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  dispatchedById      String?         @map("dispatched_by_id") @db.Uuid
  validatedById       String?         @map("validated_by_id") @db.Uuid

  sourceBranch      Branch?         @relation("StockMoveSourceBranch", fields: [sourceBranchId], references: [id], onDelete: Restrict)
  destinationBranch Branch?         @relation("StockMoveDestinationBranch", fields: [destinationBranchId], references: [id], onDelete: Restrict)
  order             Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  purchaseOrder     PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  reversalOfMove    StockMove?      @relation("StockMoveReversal", fields: [reversalOfMoveId], references: [id], onDelete: Restrict)
  reversalMoves     StockMove[]     @relation("StockMoveReversal")
  lines             StockMoveLine[]

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([sourceBranchId, status])
  @@index([destinationBranchId, status])
  @@index([orderId, moveType])
  @@index([reversalOfMoveId])
  @@index([moveType, status])
  @@index([status, expiresAt])
  @@map("stock_move")
}

/// One planned SKU quantity inside a StockMove. This plays the role of Odoo's
/// stock.move; SerialMovement provides the serial-level execution details.
model StockMoveLine {
  id                 String  @id @default(uuid()) @db.Uuid
  stockMoveId        String  @map("stock_move_id") @db.Uuid
  skuId              Int     @map("sku_id")
  originalMoveLineId String? @map("original_move_line_id") @db.Uuid
  quantity           Int
  unitCost           Decimal @default(0) @map("unit_cost") @db.Decimal(12, 2)

  stockMove           StockMove          @relation(fields: [stockMoveId], references: [id], onDelete: Restrict)
  sku                 ProductVariant     @relation(fields: [skuId], references: [id], onDelete: Restrict)
  originalMoveLine    StockMoveLine?     @relation("StockMoveLineReversal", fields: [originalMoveLineId], references: [id], onDelete: Restrict)
  reversalLines       StockMoveLine[]    @relation("StockMoveLineReversal")
  ledgerEntries       StockLedgerEntry[]
  serialMovements     SerialMovement[]
  receivedSerialUnits SerialUnit[]       @relation("SerialUnitOrigin")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([stockMoveId, skuId])
  @@index([skuId])
  @@index([originalMoveLineId])
  @@map("stock_move_line")
}

/// Immutable balance history. Reservations and physical movements both point
/// to the StockMoveLine that caused the delta.
model StockLedgerEntry {
  id              String               @id @default(uuid()) @db.Uuid
  stockQuantId    String               @map("stock_quant_id") @db.Uuid
  stockMoveLineId String               @map("stock_move_line_id") @db.Uuid
  entryType       StockLedgerEntryType @map("entry_type")
  deltaOnHand     Int                  @default(0) @map("delta_on_hand")
  deltaReserved   Int                  @default(0) @map("delta_reserved")
  deltaQuarantine Int                  @default(0) @map("delta_quarantine")
  onHandAfter     Int                  @map("on_hand_after")
  reservedAfter   Int                  @map("reserved_after")
  quarantineAfter Int                  @map("quarantine_after")
  actorType       ActorType            @map("actor_type")
  actorId         String?              @map("actor_id")
  occurredAt      DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(3)

  stockQuant    StockQuant    @relation(fields: [stockQuantId], references: [id], onDelete: Restrict)
  stockMoveLine StockMoveLine @relation(fields: [stockMoveLineId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([stockQuantId, occurredAt])
  @@index([stockMoveLineId])
  @@map("stock_ledger_entry")
}

model SerialUnit {
  id                    String       @id @default(uuid()) @db.Uuid
  skuId                 Int          @map("sku_id")
  currentBranchId       Int?         @map("current_branch_id")
  originStockMoveLineId String       @map("origin_stock_move_line_id") @db.Uuid
