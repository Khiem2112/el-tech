  originStockMoveLine StockMoveLine    @relation("SerialUnitOrigin", fields: [originStockMoveLineId], references: [id], onDelete: Restrict)
  movements           SerialMovement[]

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([skuId, status])
  @@index([currentBranchId, status])
  @@index([originStockMoveLineId])
