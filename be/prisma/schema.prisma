/// The notification row is also the transactional outbox record. Insert it in
/// the same transaction as the business change, then deliver after commit.
model Notification {
  id                String                @id @default(uuid()) @db.Uuid
  customerId        String                @map("customer_id") @db.Uuid
  orderId           String?               @map("order_id") @db.Uuid
  deduplicationKey  String                @unique @map("deduplication_key")
  eventType         String                @map("event_type")
  title             String
  body              String                @db.Text
  channels          NotificationChannel[] @default([IN_APP])
  payload           Json                  @default("{}") @db.JsonB
  deliveryAttempts  Json                  @default("[]") @map("delivery_attempts") @db.JsonB
  publishedAt       DateTime?             @map("published_at") @db.Timestamptz(3)
  lastDeliveryAt    DateTime?             @map("last_delivery_at") @db.Timestamptz(3)
  lastDeliveryError String?               @map("last_delivery_error") @db.Text
  readAt            DateTime?             @map("read_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([customerId, readAt, createdAt])
  @@index([orderId, createdAt])
  @@index([publishedAt, createdAt])
  @@map("notification")
}
