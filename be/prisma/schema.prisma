generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ContactType {
  EMAIL
  PHONE
}

enum VerificationPurpose {
  CHECKOUT
  PROFILE_CHANGE_OLD
  PROFILE_CHANGE_NEW
  GUEST_ORDER_ACCESS
}

enum ProductLifecycle {
  DRAFT
  ACTIVE
  PAUSED
  DISCONTINUED
}

enum SalesLineType {
  SKU
  SERVICE
}

enum PcBuildType {
  PREBUILT
  CUSTOM
}

enum ServiceType {
  ASSEMBLY
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponTargetRule {
  INCLUDE
  EXCLUDE
}

enum CouponRedemptionStatus {
  RESERVED
  CONSUMED
  RELEASED
}

enum FulfillmentMethod {
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  QR
  COD
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_COD_CONFIRMATION
  CONFIRMED
  PREPARING_COMPONENTS
  ASSEMBLING
  READY_FOR_PICKUP
  SHIPPING
  DELIVERY_FAILED
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum OrderHoldReason {
  PAYMENT_REVIEW
  PAID_BUT_OUT_OF_STOCK
  PICKUP_EXPIRED
}

enum OrderAmendmentType {
  PICKUP_TO_DELIVERY
  REDELIVERY
}

enum OrderAmendmentStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  PAYMENT_PENDING
  PAID
  CANCELLED
}

enum ActorType {
  CUSTOMER
  ADMIN
  SYSTEM
  PAYMENT_PROVIDER
}

enum PaymentState {
  UNPAID
  PENDING
  PARTIALLY_PAID
  PAID
  FAILED
  EXPIRED
  REFUND_PENDING
  REFUNDED
}

enum DepositDisposition {
  HELD
  APPLIED
  REFUND_PENDING
  REFUNDED
  FORFEITED
}

enum PaymentChargeType {
  INITIAL_ORDER
  AMENDMENT
}

enum PaymentChargeStatus {
  PENDING
  PAID
  REVIEW
  FAILED
  EXPIRED
  REFUND_PENDING
  REFUNDED
}

enum PaymentTransactionResult {
  EXACT_MATCH
  UNDERPAID
  OVERPAID
  AMBIGUOUS_REFERENCE
  LATE_EXACT
  LATE_INVALID
  DUPLICATE
}

enum RefundStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum StockMoveType {
  PURCHASE_RECEIPT
  ORDER_ISSUE
  ORDER_REVERSAL
  INTERNAL_TRANSFER
  SUPPLIER_RETURN
  INTERNAL_CORRECTION
}

enum StockMoveStatus {
  DRAFT
  RESERVED
  IN_TRANSIT
  VALIDATED
  REVERSED
  CANCELLED
}

enum StockLedgerEntryType {
  RESERVE
  RELEASE_RESERVATION
  PURCHASE_RECEIPT
  ORDER_ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  SUPPLIER_RETURN
  QUARANTINE
  RELEASE_QUARANTINE
  REVERSAL
}

enum SerialStatus {
  AVAILABLE
  RESERVED
  ISSUED
  IN_TRANSIT
  QUARANTINED
  RETURNED_TO_SUPPLIER
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  RECEIVED
  CLOSED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  role          UserRole @default(CUSTOMER)

  sessions  Session[]
  accounts  Account[]
  customer  Customer?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("user")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  idToken               String?   @map("id_token") @db.Text
  password              String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id          String               @id @default(uuid()) @db.Uuid
  identifier  String
  value       String
  customerId  String?              @map("customer_id") @db.Uuid
  orderId     String?              @map("order_id") @db.Uuid
  purpose     VerificationPurpose?
  contactType ContactType?         @map("contact_type")
  expiresAt   DateTime             @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?            @map("consumed_at") @db.Timestamptz(3)

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@index([customerId])
  @@index([orderId])
  @@index([purpose, contactType, expiresAt])
  @@map("verification")
}

model Customer {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String?  @unique @map("user_id") @db.Uuid
  mergedIntoCustomerId String?  @map("merged_into_customer_id") @db.Uuid
  name                 String
  email                String
  phone                String
  emailVerifiedAt      DateTime @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt      DateTime @map("phone_verified_at") @db.Timestamptz(3)

  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  mergedInto        Customer?          @relation("CustomerMerge", fields: [mergedIntoCustomerId], references: [id], onDelete: SetNull)
  mergedCustomers   Customer[]         @relation("CustomerMerge")
  carts             Cart[]
  orders            Order[]
  verifications     Verification[]
  couponRedemptions CouponRedemption[]
  reviews           Review[]
  notifications     Notification[]

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([mergedIntoCustomerId])
  @@index([email])
  @@index([phone])
  @@index([isActive])
  @@map("customer")
}

model Category {
  id                         Int     @id @default(autoincrement())
  parentId                   Int?    @map("parent_id")
  name                       String
  slug                       String  @unique
  description                String? @db.Text
  specificationSchema        Json    @default("[]") @map("specification_schema") @db.JsonB
  specificationSchemaVersion Int     @default(1) @map("specification_schema_version")

  parent           Category?            @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  childCategories  Category[]           @relation("CategoryTree")
  productTemplates ProductTemplate[]
  promotionTargets PromotionCategory[]
  couponRules      CouponCategoryRule[]

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([parentId])
  @@index([isActive])
  @@map("category")
}

model Brand {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  description String? @db.Text

  productTemplates ProductTemplate[]

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive])
  @@map("brand")
}

model ProductTemplate {
  id             Int              @id @default(autoincrement())
  categoryId     Int              @map("category_id")
  brandId        Int              @map("brand_id")
  name           String
  slug           String           @unique
  model          String
  chipsetFamily  String?          @map("chipset_family")
  description    String?          @db.Text
  commonSpec     Json             @default("{}") @map("common_spec") @db.JsonB
  media          Json             @default("[]") @db.JsonB
  lifecycleState ProductLifecycle @default(DRAFT) @map("lifecycle_state")

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  reviews  Review[]

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([categoryId, lifecycleState, isActive])
  @@index([brandId])
  @@index([chipsetFamily])
  @@map("product_template")
}

model ProductVariant {
  id                Int              @id @default(autoincrement())
  productTemplateId Int              @map("product_template_id")
  sku               String           @unique
  barcode           String?          @unique
  variationLabel    String?          @map("variation_label")
  variantSpec       Json             @default("{}") @map("variant_spec") @db.JsonB
  serialRequired    Boolean          @default(false) @map("serial_required")
  sellingPrice      Decimal          @map("selling_price") @db.Decimal(12, 2)
  lifecycleState    ProductLifecycle @default(DRAFT) @map("lifecycle_state")

  productTemplate    ProductTemplate     @relation(fields: [productTemplateId], references: [id], onDelete: Restrict)
  bundleItems        PcBundleItem[]
  cartItems          CartItem[]
  promotionTargets   PromotionSku[]
  couponRules        CouponSkuRule[]
  orderLines         OrderLine[]
  stockQuants        StockQuant[]
  stockMoveLines     StockMoveLine[]
  serialUnits        SerialUnit[]
  purchaseOrderLines PurchaseOrderLine[]
  reviews            Review[]

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([productTemplateId, lifecycleState, isActive])
  @@index([sku])
  @@map("product_variant")
}

model PcBundle {
  id             Int              @id @default(autoincrement())
  name           String
  slug           String           @unique
  description    String?          @db.Text
  discountAmount Decimal          @default(0) @map("discount_amount") @db.Decimal(12, 0)
  lifecycleState ProductLifecycle @default(DRAFT) @map("lifecycle_state")

  items      PcBundleItem[]
  cartItems  CartItem[]
  orderLines OrderLine[]

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([lifecycleState, isActive])
  @@map("pc_bundle")
}

model PcBundleItem {
  id         String @id @default(uuid()) @db.Uuid
  pcBundleId Int    @map("pc_bundle_id")
  skuId      Int    @map("sku_id")
  quantity   Int
  sortOrder  Int    @default(0) @map("sort_order")

  pcBundle PcBundle       @relation(fields: [pcBundleId], references: [id], onDelete: Restrict)
  sku      ProductVariant @relation(fields: [skuId], references: [id], onDelete: Restrict)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([pcBundleId, skuId])
  @@index([skuId])
  @@map("pc_bundle_item")
}

model Cart {
  id          String    @id @default(uuid()) @db.Uuid
  customerId  String?   @map("customer_id") @db.Uuid
  opaqueToken String    @unique @map("opaque_token")
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([customerId, isActive])
  @@index([expiresAt])
  @@map("cart")
}

/// Database migration should enforce:
/// - SKU lines require sku_id and must not have service_type.
/// - SERVICE lines require service_type and must not have sku_id.
/// - pc_build_key, pc_build_name, and pc_build_type are either all null or all present.
/// - quantity is greater than zero.
model CartItem {
  id               String        @id @default(uuid()) @db.Uuid
  cartId           String        @map("cart_id") @db.Uuid
  skuId            Int?          @map("sku_id")
  sourcePcBundleId Int?          @map("source_pc_bundle_id")
  lineType         SalesLineType @default(SKU) @map("line_type")
  serviceType      ServiceType?  @map("service_type")
  pcBuildKey       String?       @map("pc_build_key") @db.Uuid
  pcBuildName      String?       @map("pc_build_name")
  pcBuildType      PcBuildType?  @map("pc_build_type")
  quantity         Int           @default(1)
  sortOrder        Int           @default(0) @map("sort_order")
  advisoryNotes    Json          @default("[]") @map("advisory_notes") @db.JsonB

  cart           Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku            ProductVariant? @relation(fields: [skuId], references: [id], onDelete: Restrict)
  sourcePcBundle PcBundle?       @relation(fields: [sourcePcBundleId], references: [id], onDelete: Restrict)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([cartId, pcBuildKey, sortOrder])
  @@index([skuId])
  @@index([sourcePcBundleId])
  @@map("cart_item")
}

model Branch {
  id                Int      @id @default(autoincrement())
  code              String   @unique
  name              String
  address           String   @db.Text
  openingHour       Json     @default("{}") @map("opening_hour") @db.JsonB
  deliveryPriority  Int      @default(0) @map("delivery_priority")
  deliveryAreaCodes String[] @default([]) @map("delivery_area_codes")

  coupons               Coupon[]
  orders                Order[]
  stockQuants           StockQuant[]
  sourceStockMoves      StockMove[]     @relation("StockMoveSourceBranch")
  destinationStockMoves StockMove[]     @relation("StockMoveDestinationBranch")
  serialUnits           SerialUnit[]
  purchaseOrders        PurchaseOrder[]

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([deliveryPriority, isActive])
  @@map("branch")
}

model ProductPromotion {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(12, 2)
  isExclusive   Boolean      @default(false) @map("is_exclusive")
  effectiveFrom DateTime     @map("effective_from") @db.Timestamptz(3)
  effectiveTo   DateTime     @map("effective_to") @db.Timestamptz(3)

  skuTargets      PromotionSku[]
  categoryTargets PromotionCategory[]
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([effectiveFrom, effectiveTo, isActive])
  @@map("product_promotion")
}

model PromotionSku {
  id          String @id @default(uuid()) @db.Uuid
  promotionId String @map("promotion_id") @db.Uuid
  skuId       Int    @map("sku_id")

  promotion ProductPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  sku       ProductVariant   @relation(fields: [skuId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([promotionId, skuId])
  @@index([skuId])
  @@map("promotion_sku")
}

model PromotionCategory {
  id          String @id @default(uuid()) @db.Uuid
  promotionId String @map("promotion_id") @db.Uuid
  categoryId  Int    @map("category_id")

  promotion ProductPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category  Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([promotionId, categoryId])
  @@index([categoryId])
  @@map("promotion_category")
}

model Coupon {
  id                    String         @id @default(uuid()) @db.Uuid
  branchId              Int?           @map("branch_id")
  code                  String         @unique
  name                  String
  discountType          DiscountType   @map("discount_type")
  discountValue         Decimal        @map("discount_value") @db.Decimal(12, 2)
  minimumSubtotal       Decimal        @default(0) @map("minimum_subtotal") @db.Decimal(12, 2)
  maximumDiscount       Decimal?       @map("maximum_discount") @db.Decimal(12, 2)
  requiredPaymentMethod PaymentMethod? @map("required_payment_method")
  globalQuota           Int?           @map("global_quota")
  perCustomerQuota      Int?           @map("per_customer_quota")
  effectiveFrom         DateTime       @map("effective_from") @db.Timestamptz(3)
  effectiveTo           DateTime       @map("effective_to") @db.Timestamptz(3)
  customerEligibility   Json           @default("{}") @map("customer_eligibility") @db.JsonB

  branch        Branch?              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  skuRules      CouponSkuRule[]
  categoryRules CouponCategoryRule[]
  redemptions   CouponRedemption[]

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([branchId])
  @@index([effectiveFrom, effectiveTo, isActive])
  @@map("coupon")
}

model CouponSkuRule {
  id       String           @id @default(uuid()) @db.Uuid
  couponId String           @map("coupon_id") @db.Uuid
  skuId    Int              @map("sku_id")
  rule     CouponTargetRule

  coupon Coupon         @relation(fields: [couponId], references: [id], onDelete: Cascade)
  sku    ProductVariant @relation(fields: [skuId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([couponId, skuId, rule])
  @@index([skuId])
  @@map("coupon_sku_rule")
}

model CouponCategoryRule {
  id         String           @id @default(uuid()) @db.Uuid
  couponId   String           @map("coupon_id") @db.Uuid
  categoryId Int              @map("category_id")
  rule       CouponTargetRule

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([couponId, categoryId, rule])
  @@index([categoryId])
  @@map("coupon_category_rule")
}

model DeliveryFeeConfig {
  id                    String    @id @default(uuid()) @db.Uuid
  fixedFee              Decimal   @map("fixed_fee") @db.Decimal(12, 2)
  freeShippingThreshold Decimal   @map("free_shipping_threshold") @db.Decimal(12, 2)
  effectiveFrom         DateTime  @map("effective_from") @db.Timestamptz(3)
  effectiveTo           DateTime? @map("effective_to") @db.Timestamptz(3)

  orders     Order[]
  amendments OrderAmendment[]

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([effectiveFrom, effectiveTo, isActive])
  @@map("delivery_fee_config")
}

model Order {
  id                      String            @id @default(uuid()) @db.Uuid
  code                    String            @unique
  idempotencyKey          String            @unique @map("idempotency_key")
  customerId              String            @map("customer_id") @db.Uuid
  fulfillmentBranchId     Int               @map("fulfillment_branch_id")
  deliveryFeeConfigId     String?           @map("delivery_fee_config_id") @db.Uuid
  fulfillmentMethod       FulfillmentMethod @map("fulfillment_method")
  paymentMethod           PaymentMethod     @map("payment_method")
  status                  OrderStatus
  holdReason              OrderHoldReason?  @map("hold_reason")
  cancellationReason      String?           @map("cancellation_reason")
  redeliveryAttemptCount  Int               @default(0) @map("redelivery_attempt_count")
  subtotal                Decimal           @db.Decimal(12, 2)
  productDiscount         Decimal           @default(0) @map("product_discount") @db.Decimal(12, 2)
  couponDiscount          Decimal           @default(0) @map("coupon_discount") @db.Decimal(12, 2)
  shippingFee             Decimal           @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  taxAmount               Decimal           @default(0) @map("tax_amount") @db.Decimal(12, 2)
  roundingAdjustment      Decimal           @default(0) @map("rounding_adjustment") @db.Decimal(12, 2)
  grandTotal              Decimal           @map("grand_total") @db.Decimal(12, 2)
  receiverName            String            @map("receiver_name")
  receiverEmail           String            @map("receiver_email")
  receiverPhone           String            @map("receiver_phone")
  receiverEmailVerifiedAt DateTime          @map("receiver_email_verified_at") @db.Timestamptz(3)
  receiverPhoneVerifiedAt DateTime          @map("receiver_phone_verified_at") @db.Timestamptz(3)
  deliveryAddressSnapshot Json?             @map("delivery_address_snapshot") @db.JsonB
  branchSnapshot          Json              @map("branch_snapshot") @db.JsonB
  pricingSnapshot         Json              @map("pricing_snapshot") @db.JsonB
  submittedAt             DateTime          @default(now()) @map("submitted_at") @db.Timestamptz(3)
  confirmedAt             DateTime?         @map("confirmed_at") @db.Timestamptz(3)
  completedAt             DateTime?         @map("completed_at") @db.Timestamptz(3)
  cancelledAt             DateTime?         @map("cancelled_at") @db.Timestamptz(3)

  customer          Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  fulfillmentBranch Branch               @relation(fields: [fulfillmentBranchId], references: [id], onDelete: Restrict)
  deliveryFeeConfig DeliveryFeeConfig?   @relation(fields: [deliveryFeeConfigId], references: [id], onDelete: Restrict)
  lines             OrderLine[]
  couponRedemption  CouponRedemption?
  amendments        OrderAmendment[]
  statusHistories   OrderStatusHistory[]
  payment           Payment?
  stockMoves        StockMove[]
  reviews           Review[]
  verifications     Verification[]
  notifications     Notification[]

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([customerId, createdAt])
  @@index([fulfillmentBranchId, status])
  @@index([status, submittedAt])
  @@index([deliveryFeeConfigId])
  @@map("order")
}

/// Database migration should enforce:
/// - SKU lines require sku_id and must not have service_type.
/// - SERVICE lines require service_type and must not have sku_id.
/// - pc_build_key, pc_build_name_snapshot, and pc_build_type_snapshot are either all null or all present.
/// - quantity is greater than zero.
model OrderLine {
  id                  String        @id @default(uuid()) @db.Uuid
  orderId             String        @map("order_id") @db.Uuid
  skuId               Int?          @map("sku_id")
  sourcePcBundleId    Int?          @map("source_pc_bundle_id")
  lineType            SalesLineType @default(SKU) @map("line_type")
  serviceType         ServiceType?  @map("service_type")
  pcBuildKey          String?       @map("pc_build_key") @db.Uuid
  pcBuildNameSnapshot String?       @map("pc_build_name_snapshot")
  pcBuildTypeSnapshot PcBuildType?  @map("pc_build_type_snapshot")
  skuSnapshot         String?       @map("sku_snapshot")
  nameSnapshot        String        @map("name_snapshot")
  specSnapshot        Json          @default("{}") @map("spec_snapshot") @db.JsonB
  taxSnapshot         Json          @default("{}") @map("tax_snapshot") @db.JsonB
  promotionSnapshots  Json          @default("[]") @map("promotion_snapshots") @db.JsonB
  quantity            Int
  unitPrice           Decimal       @map("unit_price") @db.Decimal(12, 2)
  productDiscount     Decimal       @default(0) @map("product_discount") @db.Decimal(12, 2)
  couponDiscount      Decimal       @default(0) @map("coupon_discount") @db.Decimal(12, 2)
  netAmount           Decimal       @map("net_amount") @db.Decimal(12, 2)
  sortOrder           Int           @default(0) @map("sort_order")

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sku            ProductVariant? @relation(fields: [skuId], references: [id], onDelete: Restrict)
  sourcePcBundle PcBundle?       @relation(fields: [sourcePcBundleId], references: [id], onDelete: Restrict)
  review         Review?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([orderId, pcBuildKey, sortOrder])
  @@index([skuId])
  @@index([sourcePcBundleId])
  @@map("order_line")
}

model CouponRedemption {
