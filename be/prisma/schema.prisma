model SerialMovement {
  id              String       @id @default(uuid()) @db.Uuid
  serialUnitId    String       @map("serial_unit_id") @db.Uuid
  stockMoveLineId String       @map("stock_move_line_id") @db.Uuid
  fromBranchId    Int?         @map("from_branch_id")
  toBranchId      Int?         @map("to_branch_id")
  resultingStatus SerialStatus @map("resulting_status")
