{
  "version": 2,
  "builds": [
    {
      "src": "fe/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/pc-fe/browser"
      }
    },
    {
      "src": "be/src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/v1/(.*)",
      "dest": "be/src/index.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "be/src/index.ts"
    },
    {
      "src": "/health",
      "dest": "be/src/index.ts"
    },
    {
      "src": "/(.*\\.[a-zA-Z0-9]+)",
      "dest": "/fe/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/fe/index.html"
    }
  ]
}
