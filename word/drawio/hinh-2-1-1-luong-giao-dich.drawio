        <mxCell id="c1" value="1. Khám phá sản phẩm&lt;br&gt;&lt;i&gt;Tra cứu Catalog / PC Builder&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;" vertex="1" parent="1">
