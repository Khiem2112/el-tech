        <mxCell id="t1" value="&lt;b&gt;LUỒNG GIAO DỊCH TRỰC TUYẾN EL-TECH (MÔ HÌNH TINH GIẢN)&lt;/b&gt;&lt;br&gt;Một cửa hàng - Một kho - Thanh toán QR/COD toàn phần - Không cọc" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;align=center;" vertex="1" parent="1">
