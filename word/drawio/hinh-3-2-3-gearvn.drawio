  <diagram id="survey-gearvn" name="Survey">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b&gt;ẢNH MINH CHỨNG KHẢO SÁT HỆ THỐNG: WEBSITE THƯƠNG MẠI ĐIỆN TỬ GEARVN (GEARVN.COM)&lt;/b&gt;&lt;br&gt;Nguồn khảo sát thực tế: https://gearvn.com (Thời điểm: Q4/2026)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1000" height="60" as="geometry"/>
        </mxCell>
<mxCell id="obs_0" value="&lt;b&gt;1. Giao diện trang chủ và phân cấp danh mục&lt;/b&gt;&lt;br&gt;Menu đa cấp thể hiện trực quan các dòng linh kiện PC (CPU, VGA, Mainboard); có banner nổi bật các chương trình khuyến mãi và PC dựng sẵn (G-PC)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="960" height="60" as="geometry"/>
        </mxCell>
<mxCell id="obs_1" value="&lt;b&gt;2. Công cụ xây dựng cấu hình máy tính (PC Builder)&lt;/b&gt;&lt;br&gt;Cung cấp giao diện chọn theo 8 linh kiện cơ bản, tự động cộng tổng giá tiền và gợi ý công suất nguồn tương ứng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="215" width="960" height="60" as="geometry"/>
        </mxCell>
<mxCell id="obs_2" value="&lt;b&gt;3. Quy trình giỏ hàng và thanh toán&lt;/b&gt;&lt;br&gt;Cho phép thanh toán VNPay-QR, thẻ tín dụng và COD; chính sách đổi trả hỗ trợ trong 7 ngày; áp dụng tính năng đăng ký thành viên nhận chiết khấu." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="960" height="60" as="geometry"/>
        </mxCell>
<mxCell id="obs_3" value="&lt;b&gt;4. Giới hạn quan sát và bài học cho EL-TECH&lt;/b&gt;&lt;br&gt;Hệ thống vận hành chuỗi nhiều showroom lớn; luồng xử lý tồn kho phân tán liên chi nhánh phức tạp; EL-TECH kế thừa trải nghiệm lọc linh kiện nhưng tinh giản về một kho duy nhất." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="365" width="960" height="60" as="geometry"/>
        </mxCell>
      </root>
