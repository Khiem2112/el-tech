        <mxCell id="t1" value="&lt;b&gt;SƠ ĐỒ BỐI CẢNH TÁC NHÂN VÀ RANH GIỚI HỆ THỐNG EL-TECH&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1080" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="sys" value="&lt;b&gt;HỆ THỐNG PHẦN MỀM EL-TECH&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Storefront Portal (Angular)&lt;br&gt;- Admin Portal (Angular)&lt;br&gt;- Backend REST API (Express)&lt;br&gt;- Database (PostgreSQL / Prisma)&lt;br&gt;&lt;i&gt;Ranh giới xử lý tự động trong hệ thống&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="110" width="360" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;Khách vãng lai (Guest)&lt;/b&gt;&lt;br&gt;- Xem Catalog / PC Builder&lt;br&gt;- Đặt hàng (QR/COD)&lt;br&gt;- Tra cứu đơn (Mã/Phone/OTP)&lt;br&gt;- Đánh giá sản phẩm tự do" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="a2" value="&lt;b&gt;Khách có tài khoản&lt;/b&gt;&lt;br&gt;- Toàn quyền như Guest&lt;br&gt;- Lưu hồ sơ &amp;amp; sổ địa chỉ&lt;br&gt;- Lịch sử đơn hàng cá nhân" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="a3" value="&lt;b&gt;Quản trị viên (Admin)&lt;/b&gt;&lt;br&gt;- Quản lý Catalog, SKU, BOM&lt;br&gt;- Quản trị Kho, PO, Serial&lt;br&gt;- Xử lý vòng đời 9 trạng thái đơn&lt;br&gt;- Tiếp nhận khiếu nại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7aa;strokeColor=#ea580c;" vertex="1" parent="1"><mxGeometry x="840" y="110" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="ext1" value="&lt;b&gt;Dịch vụ OTP (SMS/Email)&lt;/b&gt;&lt;br&gt;Xác thực tra cứu đơn vãng lai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef08a;strokeColor=#ca8a04;" vertex="1" parent="1"><mxGeometry x="840" y="240" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="ext2" value="&lt;b&gt;Hoạt động ngoài màn hình (Off-screen)&lt;/b&gt;&lt;br&gt;Lắp ráp vật lý, Giao vận Carrier,&lt;br&gt;Xử lý khiếu nại đổi trả bồi hoàn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;" vertex="1" parent="1"><mxGeometry x="840" y="330" width="260" height="70" as="geometry"/></mxCell>
