        <mxCell id="t" value="&lt;b&gt;ẢNH MINH CHỨNG KHẢO SÁT HỆ THỐNG: WEBSITE THƯƠNG MẠI ĐIỆN TỬ PHONG VŨ (PHONGVU.VN)&lt;/b&gt;&lt;br&gt;Nguồn khảo sát thực tế: https://phongvu.vn (Thời điểm: Q4/2026)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1000" height="60" as="geometry"/>
        </mxCell>
<mxCell id="obs_0" value="&lt;b&gt;1. Cấu trúc danh mục đa ngành hàng&lt;/b&gt;&lt;br&gt;Kinh doanh kết hợp linh kiện PC, Laptop, Điện thoại, Thiết bị gia dụng thông minh; hệ sinh thái bán lẻ tổng hợp." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="960" height="60" as="geometry"/>
        </mxCell>
<mxCell id="obs_1" value="&lt;b&gt;2. Trải nghiệm tìm kiếm và tra cứu đơn hàng&lt;/b&gt;&lt;br&gt;Thanh tìm kiếm thông minh gợi ý từ khóa tức thì; cổng tra cứu đơn hàng bằng số điện thoại yêu cầu mã OTP bảo mật." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="215" width="960" height="60" as="geometry"/>
        </mxCell>
<mxCell id="obs_2" value="&lt;b&gt;3. Luồng thanh toán và khuyến mãi voucher&lt;/b&gt;&lt;br&gt;Tích hợp cổng VNPAY, Momo, ZaloPay và thẻ thành viên PV Point; kiểm tra điều kiện mã coupon nghiêm ngặt tại checkout." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="960" height="60" as="geometry"/>
        </mxCell>
<mxCell id="obs_3" value="&lt;b&gt;4. Giới hạn quan sát và bài học cho EL-TECH&lt;/b&gt;&lt;br&gt;Kinh doanh quá nhiều ngành hàng ngoài PC làm loãng công cụ PC Builder; EL-TECH kiên quyết loại bỏ laptop/điện thoại để chuyên biệt hóa 100% cho PC và linh kiện." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="365" width="960" height="60" as="geometry"/>
        </mxCell>
