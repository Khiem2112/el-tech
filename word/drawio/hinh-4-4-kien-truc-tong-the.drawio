        <mxCell id="c_fe" value="&lt;b&gt;CLIENT TIER (Angular 22 Standalone)&lt;/b&gt;&lt;br&gt;- Storefront Portal: PC Builder, Catalog, Cart, Checkout, Order Lookup&lt;br&gt;- Admin Portal: Catalog Manager, Procurement PO, Kanban Orders, Inventory&lt;br&gt;- Spartan UI + Tailwind CSS (NVIDIA Dark Style)&lt;br&gt;- Angular Native Signals State Management" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="1140" height="90" as="geometry"/></mxCell>
